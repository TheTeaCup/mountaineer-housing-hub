MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=mountaineer_housing_hub
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DBNAME=mountaineer_housing_hub
# Optional: use a separate administrator only while running npm run db:setup.
# DB_SETUP_USERNAME=root
# DB_SETUP_PASSWORD=replace-with-your-admin-password
REDIS_URL=redis://:replace-with-your-redis-password@127.0.0.1:6379
PORT=3001

FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=mountaineer-housing-hub
CLOUDFLARE_R2_CONNECTION_STRING=https://replace-with-your-account-id.r2.cloudflarestorage.com

# Optional when the backend is behind a trusted reverse proxy.
# Express proxy trust: blank/false, true, a hop count, or comma-separated IP/CIDR ranges.
TRUST_PROXY=
AUTH_PROXY_SECRET=
